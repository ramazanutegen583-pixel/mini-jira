# Local development: SQLite and a demo account. Replace secrets before deployment.
APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./data/minijira.db
JWT_SECRET=replace-this-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Docker Compose: set APP_ENV=production and configure DB_PASSWORD too.
